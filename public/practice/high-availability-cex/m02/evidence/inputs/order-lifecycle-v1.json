    {
      "scenarioId": "invalid-cancel-does-not-mutate-or-consume-sequence",
      "commands": [
        {
          "caseId": "seed-resting-bid-before-invalid-cancels",
          "type": "PLACE",
          "input": {
            "instrumentId": "BTC-USDT",
            "orderId": 100,
            "side": "BUY",
            "priceTicks": 99,
            "quantityLots": 4
          },
          "expected": {
            "events": [
              {
                "type": "ACCEPTED",
                "sequence": 1,
                "orderId": 100,
                "side": "BUY",
                "priceTicks": 99,
                "quantityLots": 4
              },
              {
                "type": "RESTED",
                "sequence": 1,
                "orderId": 100,
                "side": "BUY",
                "priceTicks": 99,
                "remainingQuantityLots": 4
              }
            ],
            "bookAfter": {
              "bids": [
                {
                  "priceTicks": 99,
                  "orders": [
                    { "sequence": 1, "orderId": 100, "remainingQuantityLots": 4 }
                  ]
                }
              ],
              "asks": []
            }
          }
        },
        {
          "caseId": "reject-cancel-unknown-instrument",
          "type": "CANCEL",
          "input": { "instrumentId": "ETH-USDT", "orderId": 0 },
          "expected": {
            "events": [
              { "type": "REJECTED", "code": "UNKNOWN_INSTRUMENT", "field": "instrumentId" }
            ],
            "bookAfter": {
              "bids": [
                {
                  "priceTicks": 99,
                  "orders": [
                    { "sequence": 1, "orderId": 100, "remainingQuantityLots": 4 }
                  ]
                }
              ],
              "asks": []
            }
          }
        },
        {
          "caseId": "reject-cancel-nonpositive-order-id",
          "type": "CANCEL",
          "input": { "instrumentId": "BTC-USDT", "orderId": 0 },
          "expected": {
