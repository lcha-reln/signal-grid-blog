{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lcha-reln/cex-matching/main/schemas/matching.m12.topology.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "status", "implementation", "clusterId", "memberCount", "quorumSize",
    "aeronAppointedLeaderId", "automaticLeaderElection", "initialLeaderIsRuntimeObservation",
    "contractCorrection", "localhostOnly", "memberProcessStarts", "externalForceStops",
    "teardownComplete", "childProcessesAliveAfterTeardown", "ownerProcessId",
    "childClasspathStrategy", "archiveMarkFileLivenessTimeoutMillis",
    "restartSafetyPredicate", "restartSafetyReason", "restartSafetyWitnessCount",
    "restartSafetyWitnesses",
    "statusFreshnessClock", "wallClockUsedForStatusAcceptance", "stableSnapshotWitnessCount",
    "stableSnapshotWitnesses", "appliedUnknownAttemptOrdinal",
    "appliedUnknownObservedOnAllMembersBeforeLeaderKill",
    "appliedUnknownExpectedNextApplicationSequence", "appliedUnknownExpectedIdentityCount",
    "appliedUnknownMembersBeforeLeaderKill", "initialMembers", "convergedMembers",
    "processStarts", "forcedStops"
  ],
  "properties": {
    "schemaVersion": { "const": "matching.m12.topology.v1" },
    "status": { "const": "PASS" },
    "implementation": { "const": "REAL_AERON_CHILD_PROCESSES" },
    "clusterId": { "const": 12 },
    "memberCount": { "const": 3 },
    "quorumSize": { "const": 2 },
    "aeronAppointedLeaderId": { "const": -1 },
    "automaticLeaderElection": { "const": true },
    "initialLeaderIsRuntimeObservation": { "const": true },
    "contractCorrection": { "$ref": "#/$defs/contractCorrection" },
    "localhostOnly": { "const": true },
    "memberProcessStarts": { "const": 6 },
    "externalForceStops": { "const": 3 },
    "teardownComplete": { "const": true },
    "childProcessesAliveAfterTeardown": { "const": 0 },
    "ownerProcessId": { "type": "integer", "minimum": 1 },
    "childClasspathStrategy": { "enum": ["INHERITED_JAVA_CLASS_PATH", "STRICT_CODE_SOURCE_FALLBACK"] },
    "archiveMarkFileLivenessTimeoutMillis": { "const": 10000 },
    "restartSafetyPredicate": { "const": "ARCHIVE_MARK_FILE_ACTIVITY_AGE_GT_LIVENESS_TIMEOUT" },
    "restartSafetyReason": { "const": "A forced-stopped member is restarted only after a live ArchiveMarkFile activity-timestamp read observes age strictly greater than the dependency-pinned liveness timeout." },
    "restartSafetyWitnessCount": { "const": 3 },
    "restartSafetyWitnesses": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/restartSafetyWitness" } },
    "statusFreshnessClock": { "const": "MONOTONIC_STATUS_SEQUENCE_ADVANCE" },
    "wallClockUsedForStatusAcceptance": { "const": false },
    "stableSnapshotWitnessCount": { "type": "integer", "minimum": 1, "maximum": 64 },
    "stableSnapshotWitnesses": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/stableSnapshotWitness" } },
    "appliedUnknownAttemptOrdinal": { "const": 42 },
    "appliedUnknownObservedOnAllMembersBeforeLeaderKill": { "const": true },
    "appliedUnknownExpectedNextApplicationSequence": { "const": 34 },
    "appliedUnknownExpectedIdentityCount": { "const": 33 },
    "appliedUnknownMembersBeforeLeaderKill": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/appliedStatus" } },
    "initialMembers": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/member" } },
    "convergedMembers": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/member" } },
    "processStarts": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/processStart" } },
    "forcedStops": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/forcedStop" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "memberId": { "type": "integer", "minimum": 0, "maximum": 2 },
    "role": { "enum": ["LEADER", "FOLLOWER"] },
    "nonBlank": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "aeronFailStopWarning": { "type": "string", "pattern": "^io\\.aeron\\.cluster\\.client\\.ClusterEvent: WARN - (leader heartbeat timeout|inactive follower quorum|quorum position went backwards: leaderCommitPosition=[0-9]+ quorumPosition=[0-9]+)$" },
    "contractCorrection": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "status", "frozenWorkloadSha256", "frozenField", "frozenAppointedInitialLeaderId", "frozenAppointmentCompatibleWithThreeMemberHa", "effectiveAeronAppointedLeaderId", "automaticElection", "initialLeaderSelection", "initialLeaderId", "reason"],
      "properties": {
        "schemaVersion": { "const": "matching.m12.contract-correction.v1" },
        "status": { "const": "PASS" },
        "frozenWorkloadSha256": { "const": "20ed1e75cd3cd86dc15a7f1f64465524a5638757abe676eb51f20bc5423b89a1" },
        "frozenField": { "const": "realClusterProfile.appointedInitialLeaderId" },
        "frozenAppointedInitialLeaderId": { "const": 0 },
        "frozenAppointmentCompatibleWithThreeMemberHa": { "const": false },
        "effectiveAeronAppointedLeaderId": { "const": -1 },
        "automaticElection": { "const": true },
        "initialLeaderSelection": { "const": "OBSERVED_AUTOMATIC_ELECTION" },
        "initialLeaderId": { "$ref": "#/$defs/memberId" },
        "reason": { "const": "Aeron appointedLeaderId disables automatic election and prevents the required Leader failover." }
      }
    },
    "restartSafetyWitness": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "memberId", "stoppedProcessId", "archiveMarkFile", "lastActivityTimestampMillis", "observedAtMillis", "ageMillis", "livenessTimeoutMillis", "probeCount", "waitElapsedNanos", "aeronVersion", "predicate", "activityTimestampPositive", "ageStrictlyExceedsLivenessTimeout"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 3 },
        "memberId": { "$ref": "#/$defs/memberId" },
        "stoppedProcessId": { "type": "integer", "minimum": 1 },
        "archiveMarkFile": { "$ref": "#/$defs/nonBlank" },
        "lastActivityTimestampMillis": { "type": "integer", "minimum": 1 },
        "observedAtMillis": { "type": "integer", "minimum": 1 },
        "ageMillis": { "type": "integer", "minimum": 10001 },
        "livenessTimeoutMillis": { "const": 10000 },
        "probeCount": { "type": "integer", "minimum": 1 },
        "waitElapsedNanos": { "type": "integer", "minimum": 0 },
        "aeronVersion": { "const": "1.52.2" },
        "predicate": { "const": "ARCHIVE_MARK_FILE_ACTIVITY_AGE_GT_LIVENESS_TIMEOUT" },
        "activityTimestampPositive": { "const": true },
        "ageStrictlyExceedsLivenessTimeout": { "const": true }
      }
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["memberId", "processId", "role", "leadershipTermId", "nextApplicationSequence", "identityCount", "semanticStateDigest", "identityResultDigest", "aeronDirectory", "archiveDirectory", "clusterDirectory", "portBlockBase", "udpPorts", "componentErrorCount"],
      "properties": {
        "memberId": { "$ref": "#/$defs/memberId" },
        "processId": { "type": "integer", "minimum": 1 },
        "role": { "$ref": "#/$defs/role" },
        "leadershipTermId": { "type": "integer", "minimum": 0 },
        "nextApplicationSequence": { "type": "integer", "minimum": 1, "maximum": 67 },
        "identityCount": { "type": "integer", "minimum": 0, "maximum": 66 },
        "semanticStateDigest": { "$ref": "#/$defs/sha256" },
        "identityResultDigest": { "$ref": "#/$defs/sha256" },
        "aeronDirectory": { "$ref": "#/$defs/nonBlank" },
        "archiveDirectory": { "$ref": "#/$defs/nonBlank" },
        "clusterDirectory": { "$ref": "#/$defs/nonBlank" },
        "portBlockBase": { "type": "integer", "minimum": 1024, "maximum": 65530 },
        "udpPorts": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "componentErrorCount": { "const": 0 }
      }
    },
    "stabilityStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["memberId", "processId", "statusSequence", "observedAtEpochMillis", "role", "electionState", "leadershipTermId", "commitPosition", "logPosition", "nextApplicationSequence", "identityCount", "semanticStateDigest", "identityResultDigest", "componentErrorCount", "diagnosticWarningCount", "droppedDiagnosticWarnings", "diagnosticWarnings"],
      "properties": {
        "memberId": { "$ref": "#/$defs/memberId" },
        "processId": { "type": "integer", "minimum": 1 },
        "statusSequence": { "type": "integer", "minimum": 1 },
        "observedAtEpochMillis": { "type": "integer", "minimum": 1 },
        "role": { "$ref": "#/$defs/role" },
        "electionState": { "const": "CLOSED" },
        "leadershipTermId": { "type": "integer", "minimum": 0 },
        "commitPosition": { "type": "integer", "minimum": 0 },
        "logPosition": { "type": "integer", "minimum": 0 },
        "nextApplicationSequence": { "type": "integer", "minimum": 1, "maximum": 67 },
        "identityCount": { "type": "integer", "minimum": 0, "maximum": 66 },
        "semanticStateDigest": { "$ref": "#/$defs/sha256" },
        "identityResultDigest": { "$ref": "#/$defs/sha256" },
        "componentErrorCount": { "const": 0 },
        "diagnosticWarningCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "droppedDiagnosticWarnings": { "const": 0 },
        "diagnosticWarnings": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/aeronFailStopWarning" } }
      }
    },
    "stableSnapshotWitness": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "condition", "statusPublishIntervalMillis", "freshnessBoundMillis", "elapsedNanos", "allMemberStatusSequencesAdvanced", "monotonicElapsedWithinFreshnessBound", "firstSnapshot", "secondSnapshot"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 64 },
        "condition": { "type": "string", "minLength": 1, "maxLength": 256 },
        "statusPublishIntervalMillis": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "freshnessBoundMillis": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "elapsedNanos": { "type": "integer", "minimum": 0 },
        "allMemberStatusSequencesAdvanced": { "const": true },
        "monotonicElapsedWithinFreshnessBound": { "const": true },
        "firstSnapshot": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/stabilityStatus" } },
        "secondSnapshot": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/stabilityStatus" } }
      }
    },
    "appliedStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["memberId", "processId", "role", "electionState", "leadershipTermId", "commitPosition", "logPosition", "nextApplicationSequence", "identityCount", "semanticStateDigest", "identityResultDigest", "componentErrorCount", "diagnosticWarningCount", "droppedDiagnosticWarnings", "diagnosticWarnings"],
      "properties": {
        "memberId": { "$ref": "#/$defs/memberId" },
        "processId": { "type": "integer", "minimum": 1 },
        "role": { "$ref": "#/$defs/role" },
        "electionState": { "const": "CLOSED" },
        "leadershipTermId": { "type": "integer", "minimum": 0 },
        "commitPosition": { "type": "integer", "minimum": 0 },
        "logPosition": { "type": "integer", "minimum": 0 },
        "nextApplicationSequence": { "const": 34 },
        "identityCount": { "const": 33 },
        "semanticStateDigest": { "$ref": "#/$defs/sha256" },
        "identityResultDigest": { "$ref": "#/$defs/sha256" },
        "componentErrorCount": { "const": 0 },
        "diagnosticWarningCount": { "const": 0 },
        "droppedDiagnosticWarnings": { "const": 0 },
        "diagnosticWarnings": { "type": "array", "maxItems": 0 }
      }
    },
    "processStart": {
      "type": "object", "additionalProperties": false,
      "required": ["memberId", "processId", "freshStart", "aliveAfterTeardown", "portBlockBase", "udpPorts", "rootDirectory", "aeronDirectory", "archiveDirectory", "clusterDirectory"],
      "properties": {
        "memberId": { "$ref": "#/$defs/memberId" },
        "processId": { "type": "integer", "minimum": 1 },
        "freshStart": { "type": "boolean" },
        "aliveAfterTeardown": { "const": false },
        "portBlockBase": { "type": "integer", "minimum": 1024, "maximum": 65530 },
        "udpPorts": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "rootDirectory": { "$ref": "#/$defs/nonBlank" },
        "aeronDirectory": { "$ref": "#/$defs/nonBlank" },
        "archiveDirectory": { "$ref": "#/$defs/nonBlank" },
        "clusterDirectory": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "forcedStop": {
      "type": "object", "additionalProperties": false,
      "required": ["memberId", "processId", "destroyForciblyRequested", "exitCode", "externalController", "roleBeforeStop", "termBeforeStop", "commitPositionBeforeStop", "logPositionBeforeStop", "componentErrorCount", "diagnosticWarningCount", "droppedDiagnosticWarnings", "diagnosticWarnings"],
      "properties": {
        "memberId": { "$ref": "#/$defs/memberId" },
        "processId": { "type": "integer", "minimum": 1 },
        "destroyForciblyRequested": { "const": true },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "externalController": { "const": true },
        "roleBeforeStop": { "$ref": "#/$defs/role" },
        "termBeforeStop": { "type": "integer", "minimum": 0 },
        "commitPositionBeforeStop": { "type": "integer", "minimum": 0 },
        "logPositionBeforeStop": { "type": "integer", "minimum": 0 },
        "componentErrorCount": { "const": 0 },
        "diagnosticWarningCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "droppedDiagnosticWarnings": { "const": 0 },
        "diagnosticWarnings": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/aeronFailStopWarning" } }
      }
    }
  }
}
