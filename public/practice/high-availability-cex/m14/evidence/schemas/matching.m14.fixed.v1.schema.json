{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "unit",
    "contractPlanVersion",
    "startCommit",
    "workloadSha256",
    "profileSha256",
    "status",
    "scenarios",
    "executedScenarios",
    "passedScenarios",
    "primitiveAttempts",
    "assertions",
    "primitiveCountMeaning"
  ],
  "properties": {
    "schemaVersion": {
      "const": "matching.m14.fixed.v1"
    },
    "unit": {
      "const": "M14"
    },
    "contractPlanVersion": {
      "const": "0.17"
    },
    "startCommit": {
      "const": "96b749861292950749701e34a6f20796f239cd4b"
    },
    "workloadSha256": {
      "const": "005afdabc720ab782ea092e416a7d9c1273daf09246eede1e43607ed110ad9e3"
    },
    "profileSha256": {
      "const": "02ef0ee44900e1a472fea03ed5cb406215550994826b53f4b708e33815c6be9d"
    },
    "status": {
      "enum": [
        "PASS",
        "STUDENT_FAILURE",
        "SYSTEM_ERROR"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "failure",
          "actualMutationActions",
          "primitiveAttempts",
          "assertions",
          "rawFile",
          "rawSha256",
          "proofObligations",
          "rawBytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M14-[A-Z0-9-]+$"
          },
          "status": {
            "enum": [
              "PASS",
              "STUDENT_FAILURE",
              "SYSTEM_ERROR"
            ]
          },
          "failure": {
            "type": "string"
          },
          "actualMutationActions": {
            "type": "integer",
            "minimum": 0
          },
          "primitiveAttempts": {
            "type": "integer",
            "minimum": 0
          },
          "assertions": {
            "type": "integer",
            "minimum": 0
          },
          "rawFile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+\\.jsonl\\.gz$"
          },
          "rawSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "proofObligations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rawBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          }
        }
      }
    },
    "executedScenarios": {
      "const": 12
    },
    "passedScenarios": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "primitiveAttempts": {
      "type": "integer",
      "minimum": 0
    },
    "assertions": {
      "type": "integer",
      "minimum": 0
    },
    "primitiveCountMeaning": {
      "const": "Concrete workload transition, read, capture, restore, frame and sink steps; oracle evaluation and diagnostic image reads are validation observations."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "passedScenarios": {
            "const": 12
          },
          "scenarios": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                },
                "failure": {
                  "const": ""
                },
                "primitiveAttempts": {
                  "minimum": 1
                },
                "assertions": {
                  "minimum": 1
                },
                "actualMutationActions": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    }
  ],
  "$id": "https://lcha-reln.github.io/cex-matching/schemas/matching.m14.fixed.v1.schema.json"
}
