{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lcha-reln/cex-matching/main/schemas/matching.m14.check.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "unit",
    "contractPlanVersion",
    "workloadSha256",
    "profileSha256",
    "corpusSha256",
    "status",
    "executed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "matching.m14.check.v2"
    },
    "unit": {
      "const": "M14"
    },
    "contractPlanVersion": {
      "const": "0.17"
    },
    "workloadSha256": {
      "const": "005afdabc720ab782ea092e416a7d9c1273daf09246eede1e43607ed110ad9e3"
    },
    "profileSha256": {
      "const": "02ef0ee44900e1a472fea03ed5cb406215550994826b53f4b708e33815c6be9d"
    },
    "corpusSha256": {
      "const": "634b17ce63eba6aeacd6cab8cc04a69786dac3a3fc15fc8fde1e942b6486e449"
    },
    "status": {
      "enum": [
        "PASS",
        "STUDENT_FAILURE",
        "SYSTEM_ERROR"
      ]
    },
    "executed": {
      "type": "boolean"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceDirty": {
      "type": "boolean"
    },
    "localScenarios": {
      "const": 12
    },
    "processWitnesses": {
      "const": 7
    },
    "generatedActions": {
      "const": 3840
    },
    "preludeBusinessCommands": {
      "const": 48
    },
    "primitiveAttempts": {
      "type": "integer",
      "minimum": 3888
    },
    "semanticMutantsKilled": {
      "const": 8
    },
    "throwingControl": {
      "const": "SYSTEM_ERROR"
    },
    "systemErrorControls": {
      "const": 3
    },
    "clusterGroups": {
      "const": 2
    },
    "memberProcesses": {
      "const": 6
    },
    "sinkProcesses": {
      "const": 1
    },
    "publisherProcesses": {
      "type": "integer",
      "minimum": 2
    },
    "inheritedStatus": {
      "const": "PASS"
    },
    "architectureStatus": {
      "const": "PASS"
    },
    "singleHost": {
      "const": true
    },
    "performanceQualified": {
      "const": false
    },
    "productRelease": {
      "type": "null"
    },
    "scenarios": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifactBindings": {
      "type": "array",
      "minItems": 100,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": [
          "sourceCommit",
          "sourceDirty",
          "localScenarios",
          "processWitnesses",
          "generatedActions",
          "preludeBusinessCommands",
          "primitiveAttempts",
          "semanticMutantsKilled",
          "throwingControl",
          "systemErrorControls",
          "clusterGroups",
          "memberProcesses",
          "sinkProcesses",
          "publisherProcesses",
          "inheritedStatus",
          "architectureStatus",
          "singleHost",
          "performanceQualified",
          "productRelease",
          "scenarios",
          "artifactBindings"
        ],
        "properties": {
          "executed": {
            "const": true
          }
        },
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "properties": {
          "executed": {
            "const": false
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "sourceCommit"
              ]
            },
            {
              "required": [
                "sourceDirty"
              ]
            },
            {
              "required": [
                "localScenarios"
              ]
            },
            {
              "required": [
                "processWitnesses"
              ]
            },
            {
              "required": [
                "generatedActions"
              ]
            },
            {
              "required": [
                "preludeBusinessCommands"
              ]
            },
            {
              "required": [
                "primitiveAttempts"
              ]
            },
            {
              "required": [
                "semanticMutantsKilled"
              ]
            },
            {
              "required": [
                "throwingControl"
              ]
            },
            {
              "required": [
                "systemErrorControls"
              ]
            },
            {
              "required": [
                "clusterGroups"
              ]
            },
            {
              "required": [
                "memberProcesses"
              ]
            },
            {
              "required": [
                "sinkProcesses"
              ]
            },
            {
              "required": [
                "publisherProcesses"
              ]
            },
            {
              "required": [
                "inheritedStatus"
              ]
            },
            {
              "required": [
                "architectureStatus"
              ]
            },
            {
              "required": [
                "singleHost"
              ]
            },
            {
              "required": [
                "performanceQualified"
              ]
            },
            {
              "required": [
                "productRelease"
              ]
            },
            {
              "required": [
                "scenarios"
              ]
            },
            {
              "required": [
                "artifactBindings"
              ]
            }
          ]
        }
      }
    }
  ]
}
