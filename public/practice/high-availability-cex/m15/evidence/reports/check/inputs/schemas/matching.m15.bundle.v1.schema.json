{
  "$defs": {
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 33554432,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "JAR",
            "LAUNCHER",
            "NOTICE"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256",
        "kind"
      ],
      "type": "object"
    },
    "relativePath": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://lcha-reln.github.io/signal-grid-blog/schemas/matching.m15.bundle.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "buildProvenance": {
            "properties": {
              "sourceMethod": {
                "const": "CURRENT_M15_CLEAN_INSTALL_DIST"
              }
            }
          },
          "operationsEntrypoint": {
            "const": "io.github.lchareln.cex.matching.operations.M15OperationsMain"
          },
          "releaseId": {
            "const": "matching-1.0.0"
          },
          "sourceRef": {
            "const": "course/m15-complete"
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "N_MINUS_ONE"
          }
        }
      },
      "then": {
        "properties": {
          "buildProvenance": {
            "properties": {
              "sourceMethod": {
                "const": "PUBLISHED_M14_CLEAN_BUILD"
              }
            }
          },
          "classpath": {
            "maxItems": 11,
            "minItems": 11
          },
          "classpathBytes": {
            "const": 6350332
          },
          "operationsEntrypoint": {
            "type": "null"
          },
          "releaseId": {
            "const": "course/m14-complete"
          },
          "sourceCommit": {
            "const": "56c4ec09ddf9fcf57f1cce763ae8b451ba7f394f"
          },
          "sourceRef": {
            "const": "course/m14-complete"
          }
        }
      }
    }
  ],
  "properties": {
    "applicationVersion": {
      "const": 262144
    },
    "buildProvenance": {
      "additionalProperties": false,
      "properties": {
        "gradle": {
          "const": "9.7.1"
        },
        "jarPolicy": {
          "const": "ORIGINAL_BYTES_NO_REPACKAGING"
        },
        "java": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sourceMethod": {
          "enum": [
            "PUBLISHED_M14_CLEAN_BUILD",
            "CURRENT_M15_CLEAN_INSTALL_DIST"
          ]
        },
        "thirdPartyNotice": {
          "const": "README.md"
        }
      },
      "required": [
        "java",
        "gradle",
        "sourceMethod",
        "jarPolicy",
        "thirdPartyNotice"
      ],
      "type": "object"
    },
    "classpath": {
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "maxItems": 64,
      "minItems": 11,
      "type": "array",
      "uniqueItems": true
    },
    "classpathBytes": {
      "maximum": 67108864,
      "minimum": 1,
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/file"
      },
      "maxItems": 64,
      "minItems": 12,
      "type": "array"
    },
    "kind": {
      "enum": [
        "N_MINUS_ONE",
        "N"
      ]
    },
    "operationsEntrypoint": {
      "enum": [
        null,
        "io.github.lchareln.cex.matching.operations.M15OperationsMain"
      ]
    },
    "profileId": {
      "const": "M15-O1"
    },
    "releaseId": {
      "enum": [
        "course/m14-complete",
        "matching-1.0.0"
      ]
    },
    "roleEntrypoints": {
      "additionalProperties": false,
      "properties": {
        "member": {
          "const": "io.github.lchareln.cex.matching.cluster.M14ClusterMember"
        },
        "publisher": {
          "const": "io.github.lchareln.cex.matching.cluster.M14PublisherProcessMain"
        },
        "sink": {
          "const": "io.github.lchareln.cex.matching.cluster.M14SinkProcessMain"
        }
      },
      "required": [
        "member",
        "publisher",
        "sink"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "matching.m15.bundle.v1"
    },
    "sourceClean": {
      "const": true
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "sourceRef": {
      "enum": [
        "course/m14-complete",
        "course/m15-complete"
      ]
    },
    "totalFileBytes": {
      "maximum": 67108864,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "profileId",
    "kind",
    "releaseId",
    "sourceCommit",
    "sourceRef",
    "sourceClean",
    "applicationVersion",
    "classpath",
    "classpathBytes",
    "files",
    "totalFileBytes",
    "roleEntrypoints",
    "operationsEntrypoint",
    "buildProvenance"
  ],
  "title": "M15 fixed bundle original-byte manifest",
  "type": "object"
}
