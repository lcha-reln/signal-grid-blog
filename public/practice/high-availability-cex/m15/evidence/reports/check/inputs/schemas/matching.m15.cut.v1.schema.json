{
  "$defs": {
    "cutId": {
      "enum": [
        "A_N_MINUS_ONE",
        "B_N_CURRENT",
        "C_ROLLBACK_CURRENT",
        "D_COLD_RECONCILED",
        "CAPACITY_HISTORY"
      ]
    },
    "grant": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "publisherId": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[ -~]+$",
          "type": "string"
        }
      },
      "required": [
        "publisherId",
        "epoch"
      ],
      "type": "object"
    },
    "instant": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "member": {
      "additionalProperties": false,
      "properties": {
        "launchId": {
          "$ref": "#/$defs/uuid"
        },
        "memberId": {
          "maximum": 2,
          "minimum": 0,
          "type": "integer"
        },
        "pid": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "processStartInstant": {
          "$ref": "#/$defs/instant"
        },
        "snapshotReceiptRef": {
          "$ref": "#/$defs/refId"
        },
        "snapshotWrittenRef": {
          "$ref": "#/$defs/refId"
        },
        "stateRef": {
          "$ref": "#/$defs/refId"
        }
      },
      "required": [
        "memberId",
        "launchId",
        "pid",
        "processStartInstant",
        "stateRef",
        "snapshotWrittenRef",
        "snapshotReceiptRef"
      ],
      "type": "object"
    },
    "nanos": {
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "rawRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 268435456,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/refId"
        },
        "logicalPath": {
          "maxLength": 512,
          "pattern": "^evidence/cut-artifacts/[A-Za-z0-9][A-Za-z0-9.-]*\\.(bin|json)$",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "MEMBER_STATE",
            "EXPECTED_STATE",
            "SNAPSHOT_WRITTEN",
            "SNAPSHOT_RECEIPT",
            "RETRY_LEDGER",
            "OUTPUT_LEDGER",
            "EXECUTION_PAYLOAD",
            "MARKET_PAYLOAD",
            "MARKET_SNAPSHOT",
            "SINK_STATE",
            "GRANT_RECEIPT",
            "DURABLE_RECEIPT",
            "MARKET_PROJECTION",
            "LIFECYCLE",
            "MARK_LIVE_HEADER",
            "MARK_STOPPED_HEADER",
            "TREE_INVENTORY"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "logicalPath",
        "bytes",
        "sha256",
        "purpose"
      ],
      "type": "object"
    },
    "refId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,127}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "shard": {
      "additionalProperties": false,
      "properties": {
        "activeRouteHash": {
          "$ref": "#/$defs/sha256"
        },
        "businessSequence": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "clusterId": {
          "maximum": 142,
          "minimum": 141,
          "type": "integer"
        },
        "controlRevision": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "expectedStateRef": {
          "$ref": "#/$defs/refId"
        },
        "genesisId": {
          "$ref": "#/$defs/uuid"
        },
        "members": {
          "items": false,
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/member"
                },
                {
                  "properties": {
                    "memberId": {
                      "const": 0
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/member"
                },
                {
                  "properties": {
                    "memberId": {
                      "const": 1
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/member"
                },
                {
                  "properties": {
                    "memberId": {
                      "const": 2
                    }
                  }
                }
              ]
            }
          ],
          "type": "array"
        },
        "originalRouteHash": {
          "$ref": "#/$defs/sha256"
        },
        "outputLedgerRef": {
          "$ref": "#/$defs/refId"
        },
        "profileHash": {
          "$ref": "#/$defs/sha256"
        },
        "retryLedgerRef": {
          "$ref": "#/$defs/refId"
        },
        "shardId": {
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        },
        "streams": {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/stream"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "EXECUTION"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/stream"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "MARKET"
                    }
                  }
                }
              ]
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "shardId",
        "clusterId",
        "businessSequence",
        "controlRevision",
        "genesisId",
        "profileHash",
        "originalRouteHash",
        "activeRouteHash",
        "expectedStateRef",
        "members",
        "streams",
        "retryLedgerRef",
        "outputLedgerRef"
      ],
      "type": "object"
    },
    "sink": {
      "additionalProperties": false,
      "properties": {
        "journalBytes": {
          "maximum": 268435456,
          "minimum": 1,
          "type": "integer"
        },
        "journalHeadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "journalRevision": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "journalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "launchId": {
          "$ref": "#/$defs/uuid"
        },
        "pid": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "processStartInstant": {
          "$ref": "#/$defs/instant"
        },
        "sinkId": {
          "const": "m15-sink-o1"
        },
        "stateRef": {
          "$ref": "#/$defs/refId"
        },
        "streams": {
          "items": false,
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/sinkStream"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "EXECUTION"
                    },
                    "shardId": {
                      "const": 1
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/sinkStream"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "MARKET"
                    },
                    "shardId": {
                      "const": 1
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/sinkStream"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "EXECUTION"
                    },
                    "shardId": {
                      "const": 2
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/sinkStream"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "MARKET"
                    },
                    "shardId": {
                      "const": 2
                    }
                  }
                }
              ]
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "sinkId",
        "launchId",
        "pid",
        "processStartInstant",
        "journalBytes",
        "journalSha256",
        "journalRevision",
        "journalHeadSha256",
        "stateRef",
        "streams"
      ],
      "type": "object"
    },
    "sinkStream": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "marketProjectionRef": {
                "$ref": "#/$defs/refId"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "EXECUTION"
              }
            }
          },
          "then": {
            "properties": {
              "digestKind": {
                "enum": [
                  "NONE",
                  "BATCH"
                ]
              },
              "marketProjectionRef": {
                "type": "null"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "contentHash": {
                "$ref": "#/$defs/sha256"
              },
              "sequence": {
                "maximum": 9223372036854775807,
                "minimum": 1,
                "type": "integer"
              }
            }
          },
          "if": {
            "properties": {
              "digestKind": {
                "const": "NONE"
              }
            }
          },
          "then": {
            "properties": {
              "contentHash": {
                "type": "null"
              },
              "sequence": {
                "const": 0
              }
            }
          }
        }
      ],
      "properties": {
        "contentHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "digestKind": {
          "enum": [
            "NONE",
            "BATCH",
            "MARKET_SNAPSHOT"
          ]
        },
        "durableReceiptRef": {
          "$ref": "#/$defs/refId"
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "grantReceiptRef": {
          "$ref": "#/$defs/refId"
        },
        "kind": {
          "enum": [
            "EXECUTION",
            "MARKET"
          ]
        },
        "marketProjectionRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/refId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "shardId": {
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "shardId",
        "kind",
        "sequence",
        "digestKind",
        "contentHash",
        "grant",
        "grantReceiptRef",
        "durableReceiptRef",
        "marketProjectionRef"
      ],
      "type": "object"
    },
    "stream": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "marketSnapshotRef": {
                "$ref": "#/$defs/refId"
              },
              "retainedCount": {
                "maximum": 16,
                "minimum": 0,
                "type": "integer"
              },
              "retainedPayloadRefs": {
                "items": {
                  "$ref": "#/$defs/refId"
                },
                "maxItems": 1,
                "minItems": 1,
                "type": "array"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "EXECUTION"
              }
            }
          },
          "then": {
            "properties": {
              "acknowledgedDigestKind": {
                "enum": [
                  "NONE",
                  "BATCH"
                ]
              },
              "marketSnapshotRef": {
                "type": "null"
              },
              "retainedEncodedBytes": {
                "maximum": 262144,
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "acknowledgedDigest": {
                "$ref": "#/$defs/sha256"
              },
              "acknowledgedSequence": {
                "maximum": 9223372036854775807,
                "minimum": 1,
                "type": "integer"
              }
            }
          },
          "if": {
            "properties": {
              "acknowledgedDigestKind": {
                "const": "NONE"
              }
            }
          },
          "then": {
            "properties": {
              "acknowledgedDigest": {
                "type": "null"
              },
              "acknowledgedSequence": {
                "const": 0
              }
            }
          }
        }
      ],
      "properties": {
        "acknowledgedDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "acknowledgedDigestKind": {
          "enum": [
            "NONE",
            "BATCH",
            "MARKET_SNAPSHOT"
          ]
        },
        "acknowledgedSequence": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "floor": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "kind": {
          "enum": [
            "EXECUTION",
            "MARKET"
          ]
        },
        "marketSnapshotRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/refId"
            },
            {
              "type": "null"
            }
          ]
        },
        "retainedCount": {
          "maximum": 32,
          "minimum": 0,
          "type": "integer"
        },
        "retainedEncodedBytes": {
          "maximum": 524288,
          "minimum": 0,
          "type": "integer"
        },
        "retainedPayloadRefs": {
          "items": {
            "$ref": "#/$defs/refId"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "tip": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "tip",
        "floor",
        "acknowledgedSequence",
        "acknowledgedDigestKind",
        "acknowledgedDigest",
        "grant",
        "retainedCount",
        "retainedEncodedBytes",
        "retainedPayloadRefs",
        "marketSnapshotRef"
      ],
      "type": "object"
    },
    "uuid": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://lcha-reln.github.io/signal-grid-blog/schemas/matching.m15.cut.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cutId": {
      "$ref": "#/$defs/cutId"
    },
    "deploymentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "refs": {
      "items": {
        "$ref": "#/$defs/rawRef"
      },
      "maxItems": 512,
      "minItems": 1,
      "type": "array"
    },
    "rootAtCapture": {
      "maxLength": 4096,
      "minLength": 2,
      "pattern": "^/[^\u0000\r\n]*$",
      "type": "string"
    },
    "runId": {
      "$ref": "#/$defs/uuid"
    },
    "schemaVersion": {
      "const": "matching.m15.cut.v1"
    },
    "shards": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/shard"
            },
            {
              "properties": {
                "clusterId": {
                  "const": 141
                },
                "shardId": {
                  "const": 1
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/shard"
            },
            {
              "properties": {
                "clusterId": {
                  "const": 142
                },
                "shardId": {
                  "const": 2
                }
              }
            }
          ]
        }
      ],
      "type": "array"
    },
    "sink": {
      "$ref": "#/$defs/sink"
    },
    "sourceBundleManifestSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "schemaVersion",
    "cutId",
    "runId",
    "deploymentSha256",
    "sourceBundleManifestSha256",
    "rootAtCapture",
    "shards",
    "sink",
    "refs"
  ],
  "title": "M15 exact independently bound application and output cut",
  "type": "object"
}
