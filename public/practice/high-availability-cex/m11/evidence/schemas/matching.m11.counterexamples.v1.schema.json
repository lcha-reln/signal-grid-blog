{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lcha-reln/cex-matching/main/schemas/matching.m11.counterexamples.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seed",
    "required",
    "persisted",
    "replayInterpreter",
    "minimalityScope",
    "globalMinimumClaim",
    "invalidHistoryCountedAsKill",
    "systemErrorCountedAsKill",
    "serializedFreshReplay",
    "serializedReplayCount",
    "serializedReplayFingerprintsExact",
    "oneDeleteAudits",
    "witnesses"
  ],
  "properties": {
    "schemaVersion": { "const": "matching.m11.counterexamples.v1" },
    "seed": { "const": "6111" },
    "required": { "const": 10 },
    "persisted": { "const": 10 },
    "replayInterpreter": { "const": "M11_TYPED_STEP_INTERPRETER_V2" },
    "minimalityScope": { "const": "ONE_MINIMAL_WITHIN_TYPED_STEP_DELETION_GRAMMAR" },
    "globalMinimumClaim": { "const": false },
    "invalidHistoryCountedAsKill": { "const": false },
    "systemErrorCountedAsKill": { "const": false },
    "serializedFreshReplay": { "const": true },
    "serializedReplayCount": { "const": 10 },
    "serializedReplayFingerprintsExact": { "const": true },
    "oneDeleteAudits": { "const": 10 },
    "witnesses": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "prefixItems": [
        { "$ref": "#/$defs/offerWitness" },
        { "$ref": "#/$defs/sessionWitness" },
        { "$ref": "#/$defs/correlationWitness" },
        { "$ref": "#/$defs/respondWitness" },
        { "$ref": "#/$defs/dropIdentityWitness" },
        { "$ref": "#/$defs/corruptSnapshotWitness" },
        { "$ref": "#/$defs/rejectPreviousWitness" },
        { "$ref": "#/$defs/metadataDigestWitness" },
        { "$ref": "#/$defs/doubleWalWitness" },
        { "$ref": "#/$defs/unsupportedVersionWitness" }
      ],
      "items": false
    }
  },
  "$defs": {
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mutant",
        "classification",
        "fingerprint",
        "rawActions",
        "minimalActions",
        "shrinkTrials",
        "actualMutationActions",
        "oneMinimal",
        "stepCountMatchesMinimalActions",
        "strictFreshReplay",
        "serializedReplayFingerprintExact",
        "minimalityScope",
        "globalMinimumClaim",
        "steps"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^cex-m11-[a-z0-9-]+$" },
        "mutant": { "type": "string", "pattern": "^M11-[A-Z0-9-]+$" },
        "classification": { "const": "STUDENT_FAILURE" },
        "fingerprint": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "rawActions": { "type": "integer", "minimum": 1 },
        "minimalActions": { "type": "integer", "minimum": 1 },
        "shrinkTrials": { "type": "integer", "minimum": 1 },
        "actualMutationActions": { "type": "integer", "minimum": 1 },
        "oneMinimal": { "const": true },
        "stepCountMatchesMinimalActions": { "const": true },
        "strictFreshReplay": { "const": true },
        "serializedReplayFingerprintExact": { "const": true },
        "minimalityScope": { "const": "ONE_MINIMAL_WITHIN_TYPED_STEP_DELETION_GRAMMAR" },
        "globalMinimumClaim": { "const": false },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "encoded"],
            "properties": {
              "kind": {
                "enum": [
                  "OFFER",
                  "SUBMIT_SESSION",
                  "SUBMIT_CORRELATION",
                  "BEGIN_SUBMIT",
                  "CRASH",
                  "RETRY",
                  "SUBMIT",
                  "TAKE_SNAPSHOT",
                  "CORRUPT_SNAPSHOT",
                  "RESTART",
                  "DECODE_REQUEST_V1",
                  "DECODE_RESPONSE_V1",
                  "DECODE_SNAPSHOT_V1",
                  "READ_DIGEST",
                  "SET_SESSION",
                  "DECODE_REQUEST_V3"
                ]
              },
              "encoded": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "offerWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-offer-as-success" }, "mutant": { "const": "M11-OFFER-AS-SUCCESS" } } }
      ]
    },
    "sessionWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-session-as-identity" }, "mutant": { "const": "M11-SESSION-AS-IDENTITY" } } }
      ]
    },
    "correlationWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-correlation-as-identity" }, "mutant": { "const": "M11-CORRELATION-AS-IDENTITY" } } }
      ]
    },
    "respondWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-respond-before-bind" }, "mutant": { "const": "M11-RESPOND-BEFORE-BIND" } } }
      ]
    },
    "dropIdentityWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-drop-identity-from-snapshot" }, "mutant": { "const": "M11-DROP-IDENTITY-FROM-SNAPSHOT" } } }
      ]
    },
    "corruptSnapshotWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-corrupt-snapshot-to-genesis" }, "mutant": { "const": "M11-CORRUPT-SNAPSHOT-TO-GENESIS" } } }
      ]
    },
    "rejectPreviousWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-reject-n-minus-one" }, "mutant": { "const": "M11-REJECT-N-MINUS-ONE" } } }
      ]
    },
    "metadataDigestWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-include-runtime-metadata-in-digest" }, "mutant": { "const": "M11-INCLUDE-RUNTIME-METADATA-IN-DIGEST" } } }
      ]
    },
    "doubleWalWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-double-write-local-wal" }, "mutant": { "const": "M11-DOUBLE-WRITE-LOCAL-WAL" } } }
      ]
    },
    "unsupportedVersionWitness": {
      "allOf": [
        { "$ref": "#/$defs/witness" },
        { "properties": { "id": { "const": "cex-m11-accept-unsupported-version" }, "mutant": { "const": "M11-ACCEPT-UNSUPPORTED-VERSION" } } }
      ]
    }
  }
}
