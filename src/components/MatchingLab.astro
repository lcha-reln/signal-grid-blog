---
import { sitePath } from "../config";
import type { PracticeCase } from "../practice/config";
import type {
  GoldenReplayPresentation,
  MatchingLabDefinition,
  MatchingLabMode,
} from "../practice/labs";
import { getPracticeUnitPath } from "../practice/content";
import type { PracticeUnit } from "../practice/units";
import "../styles/matching-lab.css";

interface Props {
  practiceCase: PracticeCase;
  unit: PracticeUnit;
  lab: MatchingLabDefinition;
}

const { practiceCase, unit, lab } = Astro.props;
const instanceId = `matching-lab-${practiceCase.slug}-${unit.code.toLowerCase()}`;
const modeLabels: Readonly<Record<MatchingLabMode, { title: string; description: string }>> = {
  JAVA_GOLDEN_REPLAY: {
    title: "权威证据回放",
    description: "只读展示由固定 Java 源码、scenario pack 与本地裁判生成的静态证据。",
  },
  BROWSER_MODEL: {
    title: "浏览器预测模型",
    description: "在隔离的有界 BigInt 模型里先预测，再揭示一条命令的事件与盘口。",
  },
  EVIDENCE_PREDICTION: {
    title: "证据状态预测题",
    description: "先判断命令结果和控制状态变化，再揭示同一份固定 evidence 的完整状态。",
  },
};
const presentationLabels: Readonly<
  Record<
    GoldenReplayPresentation,
    { heading: string; description: string; digest: string }
  >
> = {
  GOLDEN_HISTORY: {
    heading: "沿固定场景逐命令检查事件与盘口",
    description: "场景输入、参考事件与 full-depth 盘口来自同一份固定 Java evidence。",
    digest: "CANONICAL HISTORY DIGEST",
  },
  COUNTEREXAMPLE: {
    heading: "沿最小反例定位缺陷的第一次分歧",
    description:
      "strict counterexample、参考结果、mutant 实际结果与严格重放报告必须相互印证。",
    digest: "COUNTEREXAMPLE DIGEST",
  },
};
const presentation = presentationLabels[lab.goldenReplay.presentation];
const presentationHeading = lab.browserModel
  ? presentation.heading
  : "沿固定场景逐命令检查控制状态、规则归因与盘口";
const presentationDescription = lab.browserModel
  ? presentation.description
  : "命令、applicationSequence、事件、active/prepared、fence、规则归因与 full-depth book 来自同一份固定 Java evidence。";
const publicEvidence = {
  manifest: sitePath(lab.goldenReplay.manifestPath),
  scenarios: sitePath(lab.goldenReplay.scenarioPackPath),
  events: sitePath(lab.goldenReplay.eventBatchesPath),
  canonical: sitePath(lab.goldenReplay.canonicalHistoryPath),
  supporting: lab.goldenReplay.supportingReports.map((report) => ({
    role: report.role,
    url: sitePath(report.path),
    label: report.path.split("/").at(-1) ?? report.role.toLowerCase(),
  })),
};
const clientConfig = JSON.stringify({
  modes: lab.modes,
  goldenReplay: {
    presentation: lab.goldenReplay.presentation,
    scenarioPackUrl: publicEvidence.scenarios,
    eventBatchesUrl: publicEvidence.events,
    supportingReports: publicEvidence.supporting.map(({ role, url }) => ({ role, url })),
    scenarios: lab.goldenReplay.scenarios,
  },
  browserModel: lab.browserModel,
}).replaceAll("<", "\\u003c");
const browserModel = lab.browserModel;
const seedSequences = (browserModel?.seedOrders ?? []).map((seed, index) => ({
  ...seed,
  sequence: String(index + 1),
}));
const goldenScenarioCount = lab.goldenReplay.scenarios.length;
const goldenCommandCount = lab.goldenReplay.scenarios.reduce(
  (total, scenario) => total + scenario.commands,
  0,
);
const scenarioPackLabel = lab.goldenReplay.scenarioPackPath.split("/").at(-1);
const eventBatchesLabel = lab.goldenReplay.eventBatchesPath.split("/").at(-1);
const canonicalHistoryLabel = lab.goldenReplay.canonicalHistoryPath.split("/").at(-1);
const supportedCommandLabel = browserModel?.supportedCommands.join(" / ") ?? "";
const supportedExecutionPolicyLabel =
  browserModel?.supportedExecutionPolicies.join(" / ") ?? "";
const showExecutionPolicySelector =
  (browserModel?.supportedExecutionPolicies.length ?? 0) > 1;
const supportsPolicyAdmission = browserModel?.supportedExecutionPolicies.some(
  (policy) => policy === "FOK" || policy === "POST_ONLY",
) ?? false;
const supportsIoc = browserModel?.supportedExecutionPolicies.includes("IOC") ?? false;
---

<div class="matching-lab" id={instanceId} data-matching-lab>
  <header class="matching-lab-hero shell">
    <div>
      <a class="matching-lab-back" href={getPracticeUnitPath(unit)}>← 返回 {unit.code} 单元驾驶舱</a>
      <span class="eyebrow">{practiceCase.title} / {unit.code} / LOCAL-FIRST LAB</span>
      <h1>{lab.title}</h1>
      <p>{lab.summary}</p>
    </div>
    <aside class="matching-lab-boundary" aria-label="实验边界">
      <span>EXECUTION BOUNDARY</span>
      <strong>{browserModel ? "STATIC EVIDENCE + LOCAL MODEL" : "STATIC EVIDENCE + PREDICTION"}</strong>
      <ul>
        <li>不上传源码，不编译或执行 Java</li>
        <li>不连接远程裁判、账户或外部服务</li>
        <li>浏览器反馈只用于推演，不构成课程验收</li>
      </ul>
    </aside>
  </header>

  <div class="matching-lab-main shell">
    <section class="matching-lab-intro" aria-labelledby={`${instanceId}-how-heading`}>
      <div>
        <span class="eyebrow">TWO ISOLATED MODES</span>
        <h2 id={`${instanceId}-how-heading`}>把“看证据”和“做预测”明确分开</h2>
      </div>
      <p>
        权威结果来自固定 complete tag 下的 Java evidence；第二种模式要么使用可重置的隔离浏览器模型，要么只做 evidence 结果预测，两者都不会写回证据。
      </p>
    </section>

    <noscript>
      <div class="matching-lab-noscript">
        JavaScript 关闭时仍可阅读证据摘要、场景目录和边界说明；逐步回放与预测交互需要在浏览器中启用 JavaScript。Java 编译和课程验收始终在本地课程仓库完成。
      </div>
    </noscript>

    <nav class="matching-lab-tabs" aria-label="Matching Lab 模式" role="tablist">
      {lab.modes.map((mode, index) => (
        <button
          type="button"
          class="matching-lab-tab"
          id={`${instanceId}-${mode.toLowerCase()}-tab`}
          data-lab-mode={mode}
          role="tab"
          aria-controls={`${instanceId}-${mode.toLowerCase()}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
        >
          <code>{mode}</code>
          <strong>{modeLabels[mode].title}</strong>
          <span>{modeLabels[mode].description}</span>
        </button>
      ))}
    </nav>

    <section
      class="matching-lab-panel"
      id={`${instanceId}-java_golden_replay`}
      data-lab-panel="JAVA_GOLDEN_REPLAY"
      role="tabpanel"
      aria-labelledby={`${instanceId}-java_golden_replay-tab`}
    >
      <header class="matching-lab-panel-head">
        <div>
          <span class="eyebrow">JAVA_GOLDEN_REPLAY / READ ONLY</span>
          <h2 id={`${instanceId}-golden-heading`}>{presentationHeading}</h2>
        </div>
        <p>
          {presentationDescription} 页面只读取已发布的同源静态文件；摘要对应
          <code>{unit.completeRef}</code>，源码提交 <code>{unit.completeCommit}</code>。
        </p>
      </header>

      <dl class="matching-lab-metrics">
        {lab.goldenReplay.metrics.map((metric) => (
          <div>
            <dt>{metric.label}</dt>
            <dd>{metric.value}</dd>
            <small>{metric.note}</small>
          </div>
        ))}
      </dl>

      <div class="matching-lab-digest">
        <span>{presentation.digest}</span>
        <code>{lab.goldenReplay.digest}</code>
      </div>

      <div class="matching-golden-layout">
        <aside class="matching-golden-catalog">
          <label for={`${instanceId}-scenario`}>选择固定场景</label>
          <select id={`${instanceId}-scenario`} data-golden-scenario>
            {lab.goldenReplay.scenarios.map((scenario) => (
              <option value={scenario.id}>{scenario.title}</option>
            ))}
          </select>
          <ol>
            {lab.goldenReplay.scenarios.map((scenario, index) => (
              <li data-golden-catalog-item={scenario.id}>
                <span>{String(index + 1).padStart(2, "0")} / {scenario.commands} CMD</span>
                <strong>{scenario.title}</strong>
                <p>{scenario.focus}</p>
              </li>
            ))}
          </ol>
        </aside>

        <div class="matching-golden-stepper">
          <div class="matching-golden-toolbar">
            <span data-golden-progress>等待读取静态 scenario pack</span>
            <div>
              <button type="button" data-golden-previous>← 上一条</button>
              <button type="button" data-golden-reset>回到第一条</button>
              <button type="button" data-golden-next>下一条 →</button>
            </div>
          </div>
          <div class="matching-golden-stage" data-golden-stage aria-live="polite">
            <p>
              {lab.goldenReplay.presentation === "COUNTEREXAMPLE" ? (
                <><code>PREDICT BEFORE REVEAL</code>：启用 JavaScript 后，每条命令都要先判断是否首次分歧，再“锁定预测并揭示对照”。</>
              ) : !browserModel ? (
                <>场景目录已经在 HTML 中提供；启用 JavaScript 后可逐条查看固定命令、applicationSequence、事件、active/prepared、fence、规则归因与 book。</>
              ) : (
                <>场景目录已经在 HTML 中提供；启用 JavaScript 后可逐条查看固定输入、预期事件和 bookAfter。</>
              )}
            </p>
          </div>
        </div>
      </div>

      <footer class="matching-lab-sources">
        <span>STATIC SOURCES</span>
        <a href={publicEvidence.manifest}>manifest.json</a>
        <a href={publicEvidence.scenarios}>{scenarioPackLabel}</a>
        <a href={publicEvidence.events}>{eventBatchesLabel}</a>
        <a href={publicEvidence.canonical}>{canonicalHistoryLabel}</a>
        {publicEvidence.supporting.map((report) => (
          <a href={report.url}>{report.label}</a>
        ))}
      </footer>
    </section>

    {browserModel && <section
      class="matching-lab-panel"
      id={`${instanceId}-browser_model`}
      data-lab-panel="BROWSER_MODEL"
      role="tabpanel"
      aria-labelledby={`${instanceId}-browser_model-tab`}
      hidden
    >
      <header class="matching-lab-panel-head">
        <div>
          <span class="eyebrow">BROWSER_MODEL / EXPLORATION ONLY</span>
          <h2 id={`${instanceId}-model-heading`}>先写下预测，再揭示一次状态迁移</h2>
        </div>
        <p>
          只支持 <code>{browserModel.instrumentId}</code>、<code>{supportedCommandLabel}</code> 与
          <code>{supportedExecutionPolicyLabel}</code>。所有算术使用 BigInt，最多执行
          {browserModel.maxCommands} 条命令。
        </p>
      </header>

      <div class="matching-model-grid">
        <form class="matching-model-form" data-model-form novalidate>
          <header>
            <span>BOUNDED MATCHING COMMAND</span>
            <code data-model-order-id>next Place orderId = {browserModel.firstGeneratedOrderId}</code>
          </header>
          <p class="matching-model-readiness" data-model-readiness aria-live="polite">
            等待 {goldenScenarioCount} 场景 / {goldenCommandCount} 命令 corpus 自检，模型暂未解锁。
          </p>
          <dl class="matching-model-fixed">
            <div><dt>instrumentId</dt><dd>{browserModel.instrumentId}</dd></div>
            <div>
              <dt>{showExecutionPolicySelector ? "defaultPolicy" : "timeInForce"}</dt>
              <dd>{browserModel.defaultExecutionPolicy}</dd>
            </div>
          </dl>
          <div
            class:list={[
              "matching-model-fields",
              { "matching-model-fields-policy": showExecutionPolicySelector },
            ]}
          >
            <label class="matching-model-command-type">
              <span>command</span>
              <select data-model-command-type>
                {browserModel.supportedCommands.map((command) => (
                  <option value={command}>{command}</option>
                ))}
              </select>
            </label>
            <div class="matching-model-command-fields" data-model-place-fields>
              <label>
                <span>side</span>
                <select data-model-side>
                  <option value="BUY">BUY</option>
                  <option value="SELL">SELL</option>
                </select>
              </label>
              {showExecutionPolicySelector && (
                <label>
                  <span>executionPolicy</span>
                  <select data-model-execution-policy>
                    {browserModel.supportedExecutionPolicies.map((policy) => (
                      <option
                        value={policy}
                        selected={policy === browserModel.defaultExecutionPolicy}
                      >
                        {policy}
                      </option>
                    ))}
                  </select>
                </label>
              )}
              <label>
                <span>priceTicks</span>
                <input
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  value="102"
                  maxlength={browserModel.maxOrderId.length}
                  data-model-price
                />
                <small>{browserModel.minPriceTicks} – {browserModel.maxPriceTicks}</small>
              </label>
              <label>
                <span>quantityLots</span>
                <input
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  value="4"
                  maxlength={browserModel.maxQuantityLots.length}
                  data-model-quantity
                />
                <small>{browserModel.minQuantityLots} – {browserModel.maxQuantityLots}</small>
              </label>
            </div>
            <div class="matching-model-command-fields" data-model-cancel-fields hidden>
              <label>
                <span>target orderId</span>
                <input
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  value={browserModel.seedOrders[0]?.orderId ?? "1"}
                  maxlength={browserModel.maxPriceTicks.length}
                  data-model-cancel-order-id
                />
                <small>可输入活动、终态或未知 orderId</small>
              </label>
            </div>
            <label class="matching-model-prediction">
              <span>先预测 event batch</span>
              <select data-model-prediction>
                <option value="">请选择预测…</option>
                <option value="RESTS_ONLY" data-command="PLACE">只挂单：Accepted → Rested</option>
                <option value="TRADES_ONLY" data-command="PLACE">全部成交：Accepted → Trade+</option>
                <option value="TRADES_AND_RESTS" data-command="PLACE">成交后挂余量：Accepted → Trade+ → Rested</option>
                {supportsPolicyAdmission && (
                  <option value="POLICY_REJECTED" data-command="PLACE">
                    策略拒绝：PlaceRejected，盘口与身份不变
                  </option>
                )}
                {supportsIoc && (
                  <option value="REMAINDER_CANCELED_ONLY" data-command="PLACE">
                    只取消余量：Accepted → RemainderCanceled
                  </option>
                )}
                {supportsIoc && (
                  <option value="TRADES_AND_REMAINDER_CANCELED" data-command="PLACE">
                    成交后取消余量：Accepted → Trade+ → RemainderCanceled
                  </option>
                )}
                <option value="CANCEL_SUCCEEDS" data-command="CANCEL">撤单成功：Canceled</option>
                <option value="CANCEL_REJECTED" data-command="CANCEL">稳定拒绝：CancelRejected</option>
              </select>
            </label>
          </div>
          <p class="matching-model-error" data-model-error role="alert" hidden></p>
          <div class="matching-model-actions">
            <button type="submit" class="button primary" data-model-submit disabled>锁定预测并揭示</button>
            <button type="button" class="button ghost" data-model-reset>重置到初始盘口</button>
            <button type="button" class="button ghost" data-model-empty>从空盘口开始</button>
          </div>
        </form>

        <aside class="matching-model-state" aria-label="浏览器模型状态">
          <header>
            <span>ISOLATED MODEL STATE</span>
            <code><span data-model-command-count>0</span> / {browserModel.maxCommands} COMMANDS</code>
          </header>
          <p>
            初始盘口由 {seedSequences.length} 笔固定 seed order 构成；重置会恢复它们。模型状态只存在于当前页面实例。
          </p>
          <ol class="matching-model-seeds">
            {seedSequences.map((seed) => (
              <li>
                <code>seq {seed.sequence}</code>
                <span>{seed.side} {seed.quantityLots} @ {seed.priceTicks}</span>
                <small>#{seed.orderId}</small>
              </li>
            ))}
          </ol>
        </aside>
      </div>

      <div class="matching-model-reveal" data-model-reveal hidden aria-live="polite">
        <header>
          <span>PREDICTION REVEALED</span>
          <strong data-model-comparison></strong>
        </header>
        <code data-model-command></code>
        <ol data-model-events></ol>
      </div>

      <section class="matching-book" aria-labelledby={`${instanceId}-book-heading`}>
        <header>
          <div>
            <span>LOCAL L2 ORDER BOOK</span>
            <h3 id={`${instanceId}-book-heading`}>{browserModel.instrumentId}</h3>
          </div>
          <p>Price priority → acceptedSequence FIFO</p>
        </header>
        <div class="matching-book-sides">
          <section class="matching-book-side side-bid" aria-label="Bid 订单簿">
            <header><span>BID · HIGH → LOW</span><small>PRICE / FIFO QUEUE</small></header>
            <div data-model-bids></div>
          </section>
          <section class="matching-book-side side-ask" aria-label="Ask 订单簿">
            <header><span>ASK · LOW → HIGH</span><small>PRICE / FIFO QUEUE</small></header>
            <div data-model-asks></div>
          </section>
        </div>
      </section>

      <section class="matching-registry" hidden={!browserModel.showLifecycleRegistry}>
        <header>
          <div>
            <span>MODEL LIFECYCLE REGISTRY</span>
            <h3>所有已接受 orderId</h3>
          </div>
          <p>RESTING 与 book 一一对应；FILLED / CANCELED 保留终态身份</p>
        </header>
        <div data-model-registry></div>
      </section>

      <footer class="matching-model-boundary-note">
        <strong>这不是 Java 撮合器，也不是课程裁判。</strong>
        <span>它只覆盖本单元声明的命令与内存语义，不处理账户、手续费、持久化、线程、网络、Aeron、性能或高可用。</span>
      </footer>
    </section>}

    {!browserModel && <section
      class="matching-lab-panel"
      id={`${instanceId}-evidence_prediction`}
      data-lab-panel="EVIDENCE_PREDICTION"
      role="tabpanel"
      aria-labelledby={`${instanceId}-evidence_prediction-tab`}
      hidden
    >
      <header class="matching-lab-panel-head">
        <div>
          <span class="eyebrow">EVIDENCE_PREDICTION / READ THEN REVEAL</span>
          <h2 id={`${instanceId}-prediction-heading`}>先判断状态迁移，再揭示固定结果</h2>
        </div>
        <p>
          题目来自与 Golden 回放相同的静态 corpus。页面不会重新执行 Java，也不会把预测正确与否换算成课程裁判结果。
        </p>
      </header>

      <div class="matching-evidence-prediction" data-evidence-prediction>
        <header>
          <div>
            <span>FIXED EVIDENCE QUESTION</span>
            <strong data-evidence-prediction-progress>等待读取同源 evidence</strong>
          </div>
          <div>
            <button type="button" data-evidence-prediction-previous>← 上一题</button>
            <button type="button" data-evidence-prediction-next>下一题 →</button>
          </div>
        </header>
        <div class="matching-evidence-prediction-body">
          <label>
            <span>固定场景</span>
            <select data-evidence-prediction-scenario>
              {lab.goldenReplay.scenarios.map((scenario) => (
                <option value={scenario.id}>{scenario.title}</option>
              ))}
            </select>
          </label>
          <section class="matching-evidence-prediction-question">
            <span data-evidence-prediction-type>COMMAND</span>
            <code data-evidence-prediction-command>加载后显示固定命令</code>
            <label>
              <span>预测这条命令的主要结果</span>
              <select data-evidence-prediction-answer disabled>
                <option value="">请选择…</option>
                <option value="ORDER_ACCEPTED">订单被接受</option>
                <option value="ORDER_REJECTED">订单被拒绝</option>
                <option value="ORDER_CANCELED">订单撤销成功</option>
                <option value="RULE_PREPARED">规则集准备成功或幂等命中</option>
                <option value="RULE_ACTIVATED">规则集激活成功</option>
                <option value="CONTROL_REJECTED">Prepare / Activate 被拒绝</option>
              </select>
            </label>
            <button type="button" class="button primary" data-evidence-prediction-reveal disabled>
              锁定预测并揭示状态
            </button>
            <p data-evidence-prediction-feedback aria-live="polite">
              揭示前先检查 expected rule、application boundary 与当前 active / prepared。
            </p>
          </section>
          <div class="matching-evidence-prediction-result" data-evidence-prediction-result hidden></div>
        </div>
      </div>

      <footer class="matching-model-boundary-note">
        <strong>这是固定 evidence 的交互式阅读器，不是浏览器里的 Java 撮合器。</strong>
        <span>它只比较你的预测与已发布结果；Java 编译、确定性裁判和完成门禁仍在课程仓库本地运行。</span>
      </footer>
    </section>}
  </div>

  <script is:inline type="application/json" data-matching-lab-config set:html={clientConfig}></script>
</div>

<script>
  import "../practice/matching-lab";
</script>
