---
import { sitePath } from "../config";

interface Props {
  postCount: number;
  seriesCount: number;
}

const { postCount, seriesCount } = Astro.props;
---

<section class="hero shell">
  <div class="hero-copy">
    <div class="hero-kicker"><i></i> SYSTEMS / MARKETS / ENGINEERING</div>
    <h1>把复杂系统<br /><em>讲到可以运行。</em></h1>
    <p>聚焦实时消息、分布式一致性与交易系统。拆原理，讲权衡，也记录那些只有上线后才会遇见的问题。</p>
    <div class="hero-actions">
      <a class="button primary" href={sitePath("posts/")}>开始阅读 <span>→</span></a>
      <a class="button ghost" href={sitePath("series/")}>浏览专题</a>
    </div>
    <dl class="hero-stats">
      <div><dt>{String(postCount).padStart(2, "0")}</dt><dd>技术长文</dd></div>
      <div><dt>{String(seriesCount).padStart(2, "0")}</dt><dd>知识专题</dd></div>
      <div><dt>∞</dt><dd>持续构建</dd></div>
    </dl>
  </div>

  <div class="signal-visual" aria-label="抽象的分布式集群信号图" role="img">
    <div class="visual-grid" aria-hidden="true"></div>
    <div class="visual-caption"><span>LIVE TOPOLOGY</span><i></i></div>
    <svg
      class="topology-edges"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <g class="topology-links">
        <path d="M18 26 L50 45" pathLength="100"></path>
        <path d="M50 45 L82 22" pathLength="100"></path>
        <path d="M50 45 L80 70" pathLength="100"></path>
        <path d="M80 70 L20 76" pathLength="100"></path>
      </g>
      <g class="topology-pulses">
        <path d="M18 26 L50 45" pathLength="100"></path>
        <path d="M50 45 L82 22" pathLength="100"></path>
        <path d="M50 45 L80 70" pathLength="100"></path>
        <path d="M80 70 L20 76" pathLength="100"></path>
      </g>
    </svg>
    <div class="node node-a"><i></i><span>AERON</span><small>01.8ms</small></div>
    <div class="node node-b"><i></i><span>RAFT</span><small>QUORUM</small></div>
    <div class="node node-c"><i></i><span>ORDER</span><small>MATCH</small></div>
    <div class="node node-d"><i></i><span>STATE</span><small>COMMIT</small></div>
    <div class="node node-e"><i></i><span>ARCHIVE</span><small>REPLAY</small></div>
    <div class="visual-readout">
      <span>THROUGHPUT</span>
      <strong>01,248,920</strong>
      <small>EVENTS / SEC</small>
    </div>
    <div class="visual-note">CONCEPTUAL SIGNAL MAP · NOT LIVE DATA</div>
  </div>
</section>
