---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../config";
import { formatDate, getActiveSeries, getExcerpt, getPostPath, getSeries, sortPosts } from "../../lib/content";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const activeSeries = getActiveSeries(posts);
---

<BaseLayout title="文章归档" description="交易系统、有状态系统可靠性与 Java 低延迟工程文章归档。">
  <header class="page-hero">
    <span class="eyebrow">ALL TRANSMISSIONS / {String(posts.length).padStart(2, "0")}</span>
    <h1>文章归档</h1>
    <p>按时间浏览全部技术笔记。每篇文章都保留稳定链接，适合收藏、引用与持续更新。</p>
  </header>

  <section class="section">
    <div class="archive-toolbar">
      <p>共 {posts.length} 篇文章，按发布时间倒序排列。</p>
      <nav class="filter-chips" aria-label="按专题浏览">
        <a href={sitePath("posts/")} aria-current="page">全部</a>
        {activeSeries.map(({ series }) => <a href={sitePath(`series/${series.key}/`)}>{series.title}</a>)}
      </nav>
    </div>

    <div class="post-list">
      {posts.map((post, index) => {
        const series = getSeries(post);
        return (
          <a class="post-row" href={getPostPath(post)}>
            <span class="post-row-index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{post.data.title}</h2>
              <p>{getExcerpt(post, 100)}</p>
            </div>
            <span class="post-row-series">{series.title}</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
