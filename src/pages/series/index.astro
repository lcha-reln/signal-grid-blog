---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeriesCard from "../../components/SeriesCard.astro";
import { getActiveSeries } from "../../lib/content";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const activeSeries = getActiveSeries(posts);
---

<BaseLayout title="技术专题" description="围绕 Aeron、交易系统、有状态系统可靠性、Java 低延迟与 AI Agent 后端工程组织的学习路径。">
  <header class="page-hero">
    <span class="eyebrow">STRUCTURED KNOWLEDGE / {String(activeSeries.length).padStart(2, "0")}</span>
    <h1>技术专题</h1>
    <p>专题是一条有先修条件、阅读顺序和学习目标的知识主线；具体产品与技术名词则作为标签出现。</p>
  </header>
  <section class="section" aria-label="当前可读专题">
    <div class="series-grid active-series-grid">
      {activeSeries.map(({ series, posts: seriesPosts }) => (
        <SeriesCard series={series} count={seriesPosts.length} headingLevel={2} />
      ))}
    </div>
  </section>
</BaseLayout>
