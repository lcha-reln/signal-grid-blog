---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LearningPathItem from "../../components/LearningPathItem.astro";
import { SERIES } from "../../config";
import { getPostsInSeries, readingMinutes } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return SERIES.map((series) => ({
    params: { series: series.key },
    props: { series, posts: getPostsInSeries(posts, series.key) },
  }));
}

const { series, posts } = Astro.props;
const totalMinutes = posts.reduce((sum, post) => sum + readingMinutes(post), 0);
---

<BaseLayout title={series.title} description={series.description}>
  <header class="page-hero">
    <span class="eyebrow">{series.eyebrow} / PATH {series.index}</span>
    <h1>{series.title}</h1>
    <p>{series.description}</p>
    <div class="page-hero-meta">
      <span>{String(posts.length).padStart(2, "0")} CHAPTERS</span>
      <span>{posts.length > 0 ? `≈ ${totalMinutes} MIN TOTAL` : "READING TIME TBD"}</span>
      <span>{posts.length > 0 ? "CURATED PATH" : "PLANNED"}</span>
    </div>
  </header>

  <section class:list={["section", `accent-${series.color}`]}>
    {posts.length > 0 ? (
      <>
        <div class="path-brief" aria-label="学习路径说明">
          <div><span>PREREQUISITE</span><p>{series.prerequisite}</p></div>
          <div><span>OUTCOME</span><p>{series.outcome}</p></div>
          <div><span>ORDER</span><p>建议按章节顺序阅读；每一章都建立在前一章的模型之上。</p></div>
        </div>
        <div class="path-section-head">
          <span class="eyebrow">READING ROUTE / 从基础到实战</span>
          <p>{String(posts.length).padStart(2, "0")} 个章节 · 约 {totalMinutes} 分钟</p>
        </div>
        <div class="learning-path">
          {posts.map((post, index) => <LearningPathItem post={post} index={index} total={posts.length} />)}
        </div>
      </>
    ) : (
      <div class="empty-state">这条学习路径已经规划，首篇内容正在构建中。</div>
    )}
  </section>
</BaseLayout>
