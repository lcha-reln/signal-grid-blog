---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LearningPathItem from "../../components/LearningPathItem.astro";
import { getActiveSeries, readingMinutes } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return getActiveSeries(posts).map(({ series, posts: seriesPosts }) => ({
    params: { series: series.key },
    props: { series, posts: seriesPosts },
  }));
}

const { series, posts } = Astro.props;
const totalMinutes = posts.reduce((sum, post) => sum + readingMinutes(post), 0);
const globalIndexes = new Map(posts.map((post, index) => [post.id, index]));
const stages = series.stages ?? [];
for (let index = 0; index < stages.length; index += 1) {
  const previous = stages[index - 1];
  if (previous && stages[index].fromOrder <= previous.fromOrder) {
    throw new Error(`Stages for ${series.key} must use strictly increasing fromOrder values.`);
  }
}
const stageGroups = stages.map((stage, index) => {
  const nextOrder = stages[index + 1]?.fromOrder ?? Number.POSITIVE_INFINITY;
  return {
    stage,
    posts: posts.filter((post) => post.data.seriesOrder >= stage.fromOrder && post.data.seriesOrder < nextOrder),
  };
});
const stagedPostIds = new Set(stageGroups.flatMap((group) => group.posts.map((post) => post.id)));
const ungroupedPosts = stages.length > 0 ? posts.filter((post) => !stagedPostIds.has(post.id)) : [];
if (ungroupedPosts.length > 0) {
  throw new Error(`Posts outside configured stages for ${series.key}: ${ungroupedPosts.map((post) => post.id).join(", ")}`);
}
---

<BaseLayout title={series.title} description={series.description}>
  <header class="page-hero">
    <span class="eyebrow">{series.eyebrow} / PATH {series.index}</span>
    <h1>{series.title}</h1>
    <p>{series.description}</p>
    <div class="page-hero-meta">
      <span>{String(posts.length).padStart(2, "0")} CHAPTERS</span>
      <span>{posts.length > 0 ? `≈ ${totalMinutes} MIN TOTAL` : "READING TIME TBD"}</span>
      <span>{posts.length > 0 ? "CURATED PATH" : "PLANNED"}</span>
    </div>
  </header>

  <section class:list={["section", `accent-${series.color}`]}>
    {posts.length > 0 ? (
      <>
        <div class="path-brief" aria-label="学习路径说明">
          <div><span>PREREQUISITE</span><p>{series.prerequisite}</p></div>
          <div><span>OUTCOME</span><p>{series.outcome}</p></div>
          <div><span>ORDER</span><p>建议按章节顺序阅读；每一章都建立在前一章的模型之上。</p></div>
        </div>
        <div class="path-section-head">
          <span class="eyebrow">READING ROUTE / 从基础到实战</span>
          <p>{String(posts.length).padStart(2, "0")} 个章节 · 约 {totalMinutes} 分钟</p>
        </div>
        {stages.length > 0 ? (
          <div class="path-stages">
            {stageGroups.map(({ stage, posts: stagePosts }) => (
              <section class="path-stage" aria-labelledby={`stage-${stage.index}`}>
                <header class="path-stage-head">
                  <span class="path-stage-index">{stage.index}</span>
                  <div>
                    <span class="eyebrow">{stage.eyebrow}</span>
                    <h2 id={`stage-${stage.index}`}>{stage.title}</h2>
                  </div>
                  <p>{stage.description}</p>
                </header>
                <div class="learning-path">
                  {stagePosts.map((post) => (
                    <LearningPathItem
                      post={post}
                      index={globalIndexes.get(post.id) ?? 0}
                      total={posts.length}
                      headingLevel={3}
                    />
                  ))}
                </div>
              </section>
            ))}
          </div>
        ) : (
          <div class="learning-path">
            {posts.map((post, index) => <LearningPathItem post={post} index={index} total={posts.length} />)}
          </div>
        )}
      </>
    ) : (
      <div class="empty-state">这条学习路径已经规划，首篇内容正在构建中。</div>
    )}
  </section>
</BaseLayout>
